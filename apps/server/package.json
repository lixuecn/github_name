{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes",
    "build": "tsdown",
    "build:lambda": "tsdown --config tsdown.lambda.config.ts",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "env:generate": "varlock codegen",
    "package:lambda": "pnpm build:lambda && node scripts/package-lambda.mjs",
    "start": "node dist/index.mjs",
    "test": "varlock run -- tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@my-better-t-app/api": "workspace:*",
    "@my-better-t-app/auth": "workspace:*",
    "@my-better-t-app/db": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-better-t-app/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
