# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Optional GitHub token; raises the API limit from 60 to 5000 requests per hour.
# @optional
GITHUB_TOKEN=

# Optional base URL of the internal Go service (separate go-api repository), e.g. http://localhost:8080.
# When set, every github_profile read and write goes through it instead of Prisma. Not a secret.
# @optional @sensitive=false @type=url
GO_API_URL=
