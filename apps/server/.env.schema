# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Optional GitHub token; raises the API limit from 60 to 5000 requests per hour.
# @optional
GITHUB_TOKEN=

# Optional base URL of the internal Go service (apps/go-api), e.g. http://localhost:8080.
# When set, github.list reads through it instead of Prisma. Not a secret.
# @optional @sensitive=false @type=url
GO_API_URL=
